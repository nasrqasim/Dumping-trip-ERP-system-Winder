rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Norani Kanta ERP Collection Rules
    match /items/{itemId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /vendors/{vendorId} {
      allow read, write: if true;
    }
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }
    match /banks/{bankId} {
      allow read, write: if true;
    }
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /staff_payments/{paymentId} {
      allow read, write: if true;
    }
    match /trips/{tripId} {
      allow read, write: if true;
    }
    match /purchases/{purchaseId} {
      allow read, write: if true;
    }
    match /sales/{saleId} {
      allow read, write: if true;
    }
    match /ledgers/{ledgerId} {
      allow read, write: if true;
    }
    match /inventory_ledger/{entryId} {
      allow read, write: if true;
    }
    match /general_expenses/{expenseId} {
      allow read, write: if true;
    }
    match /other_incomes/{incomeId} {
      allow read, write: if true;
    }
    match /vouchers/{voucherId} {
      allow read, write: if true;
    }
  }
}
